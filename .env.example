# Model API key for the Reader agent. Not needed for anything currently in
# the repo: the default Reader is deterministic and offline, and
# `cargo test --workspace` never touches the network.
MODEL_API_KEY=

# Port the Axum API/SSE server listens on.
PORT=8080

# Port the Reader process listens on.
READER_PORT=8081

# Where the API looks for the Reader. Leave unset to use the in-process stub
# Reader (offline, no second process). Set it to run the Reader as its own
# process, which is what the fail-closed demo needs — there has to be a real
# PID to kill.
# READER_URL=http://127.0.0.1:8081
